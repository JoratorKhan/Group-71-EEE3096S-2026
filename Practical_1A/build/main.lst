  15:Core/Src/main.c **** int main(void)
  16:Core/Src/main.c **** {
  17:Core/Src/main.c ****     /* TODO: Initialize GPIO and TIM16 peripherals */
  18:Core/Src/main.c ****     GPIO_Init();
  19:Core/Src/main.c ****     TIM16_Init();
  20:Core/Src/main.c **** 
  21:Core/Src/main.c ****     while (1)
  22:Core/Src/main.c ****     {
  23:Core/Src/main.c ****         /* All PWM generation happens in the ISR; main loop remains free */
  24:Core/Src/main.c ****     }
  25:Core/Src/main.c **** }
