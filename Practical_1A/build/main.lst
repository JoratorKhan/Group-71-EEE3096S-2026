 183:Core/Src/main.c **** void set_mode(LED_Mode new_mode)
 184:Core/Src/main.c **** {
 185:Core/Src/main.c ****     current_mode = new_mode;
 186:Core/Src/main.c **** 
 187:Core/Src/main.c ****     clear_all_leds();
 188:Core/Src/main.c **** 
 189:Core/Src/main.c ****     // Reset mode-specific tracking variables
 190:Core/Src/main.c ****     current_led  = 0;
 191:Core/Src/main.c ****     direction    = 1;
 192:Core/Src/main.c **** 
 193:Core/Src/main.c ****     sparkle_state         = SPARKLE_IDLE;
 194:Core/Src/main.c ****     sparkle_off_index     = 0;
 195:Core/Src/main.c ****     sparkle_num_leds_on   = 0;
 196:Core/Src/main.c ****     sparkle_pattern       = 0;
 197:Core/Src/main.c ****     sparkle_display_until = HAL_GetTick();
 198:Core/Src/main.c ****     sparkle_next_off_time = HAL_GetTick();
 199:Core/Src/main.c **** }
 200:Core/Src/main.c **** 
 201:Core/Src/main.c **** // Shared 0..7..0 bounce logic, no duplicated turn-around LEDs
 202:Core/Src/main.c **** void advance_index(void)
 203:Core/Src/main.c **** {
 204:Core/Src/main.c ****     if (direction == 1) {
 205:Core/Src/main.c ****         if (current_led == 7) { direction = -1; current_led = 6; }
 206:Core/Src/main.c ****         else                  { current_led++; }
 207:Core/Src/main.c ****     } else {
 208:Core/Src/main.c ****         if (current_led == 0) { direction =  1; current_led = 1; }
 209:Core/Src/main.c ****         else                  { current_led--; }
 210:Core/Src/main.c ****     }
 211:Core/Src/main.c **** }
 212:Core/Src/main.c **** 
