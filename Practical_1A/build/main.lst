 124:Core/Src/main.c **** void change_timer_period(uint32_t new_period_ms)
 125:Core/Src/main.c **** {
 126:Core/Src/main.c ****     // Timer clock = 8 MHz / (7999 + 1) = 1000 Hz, so 1 tick = 1 ms.
 127:Core/Src/main.c ****     // ARR = desired_period_ms - 1
 128:Core/Src/main.c ****     uint32_t new_arr = new_period_ms - 1;
 129:Core/Src/main.c **** 
 130:Core/Src/main.c ****     TIM16->ARR = new_arr;   // write ARR directly, no re-init
 131:Core/Src/main.c ****     TIM16->CNT = 0;         // restart the count from a clean cycle
 132:Core/Src/main.c **** 
 133:Core/Src/main.c ****     current_period_ms = new_period_ms;
 134:Core/Src/main.c **** }
 135:Core/Src/main.c **** 
 136:Core/Src/main.c **** void handle_buttons(void)
 137:Core/Src/main.c **** {
 138:Core/Src/main.c ****     uint32_t now = HAL_GetTick();
 139:Core/Src/main.c **** 
 140:Core/Src/main.c ****     for (uint8_t i = 0; i < NUM_BUTTONS; i++) {
 141:Core/Src/main.c ****         GPIO_PinState raw = HAL_GPIO_ReadPin(GPIOA, button_pins[i]);
 142:Core/Src/main.c **** 
 143:Core/Src/main.c ****         // Any change in the raw level restarts the settling window.
 144:Core/Src/main.c ****         if (raw != button_last_raw[i]) {
 145:Core/Src/main.c ****             button_last_raw[i]  = raw;
 146:Core/Src/main.c ****             last_button_time[i] = now;
 147:Core/Src/main.c ****             continue;
 148:Core/Src/main.c ****         }
 149:Core/Src/main.c **** 
 150:Core/Src/main.c ****         // Not steady for long enough yet: still bouncing.
 151:Core/Src/main.c ****         if ((now - last_button_time[i]) < DEBOUNCE_MS) {
 152:Core/Src/main.c ****             continue;
 153:Core/Src/main.c ****         }
 154:Core/Src/main.c **** 
 155:Core/Src/main.c ****         // Level is settled. Act only if it differs from the last confirmed level.
 156:Core/Src/main.c ****         if (raw != button_stable[i]) {
 157:Core/Src/main.c ****             button_stable[i] = raw;
 158:Core/Src/main.c **** 
 159:Core/Src/main.c ****             // Act only on the transition into the pressed level.
 160:Core/Src/main.c ****             if (raw != button_idle_state[i]) {
 161:Core/Src/main.c ****                 switch (i) {
ARM GAS  C:\Users\Tebogo\AppData\Local\Temp\ccXvoXA9.s 			page 5


 162:Core/Src/main.c ****                     case 0:     // PA0 - speed toggle, works in every mode
 163:Core/Src/main.c ****                         speed_state = !speed_state;
 164:Core/Src/main.c ****                         change_timer_period(speed_state ? 500 : 1000);
 165:Core/Src/main.c ****                         break;
 166:Core/Src/main.c ****                     case 1:     // PA1 - running light
 167:Core/Src/main.c ****                         set_mode(MODE_1);
 168:Core/Src/main.c ****                         break;
 169:Core/Src/main.c ****                     case 2:     // PA2 - inverse running light
 170:Core/Src/main.c ****                         set_mode(MODE_2);
 171:Core/Src/main.c ****                         break;
 172:Core/Src/main.c ****                     case 3:     // PA3 - sparkle
 173:Core/Src/main.c ****                         set_mode(MODE_3);
 174:Core/Src/main.c ****                         break;
 175:Core/Src/main.c ****                     default:
 176:Core/Src/main.c ****                         break;
 177:Core/Src/main.c ****                 }
 178:Core/Src/main.c ****             }
 179:Core/Src/main.c ****         }
 180:Core/Src/main.c ****     }
 181:Core/Src/main.c **** }
