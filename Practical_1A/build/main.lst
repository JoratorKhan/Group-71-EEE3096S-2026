 219:Core/Src/main.c **** 
 220:Core/Src/main.c **** void mode2_update(void)
 221:Core/Src/main.c **** {
 222:Core/Src/main.c ****     for (uint8_t i = 0; i < 8; i++) {
 223:Core/Src/main.c ****         turn_on_led(i);
 224:Core/Src/main.c ****     }
 225:Core/Src/main.c ****     turn_off_led(current_led);
 226:Core/Src/main.c ****     advance_index();
 227:Core/Src/main.c **** }
 228:Core/Src/main.c **** 
 229:Core/Src/main.c **** void mode3_update(void)
 230:Core/Src/main.c **** {
 231:Core/Src/main.c ****     uint32_t now = HAL_GetTick();
 232:Core/Src/main.c **** 
 233:Core/Src/main.c ****     switch (sparkle_state) {
 234:Core/Src/main.c ****         case SPARKLE_IDLE:
 235:Core/Src/main.c ****             // Random 8-bit pattern, 0 to 255
 236:Core/Src/main.c ****             sparkle_pattern     = (uint8_t)(rand() & 0xFF);
 237:Core/Src/main.c ****             sparkle_num_leds_on = 0;
 238:Core/Src/main.c **** 
 239:Core/Src/main.c ****             for (uint8_t i = 0; i < 8; i++) {
 240:Core/Src/main.c ****                 if (sparkle_pattern & (1u << i)) {
 241:Core/Src/main.c ****                     turn_on_led(i);
 242:Core/Src/main.c ****                     sparkle_leds_on[sparkle_num_leds_on++] = i;
 243:Core/Src/main.c ****                 }
 244:Core/Src/main.c ****             }
 245:Core/Src/main.c **** 
 246:Core/Src/main.c ****             // Shuffle so the LEDs switch off in a random order
 247:Core/Src/main.c ****             for (uint8_t i = sparkle_num_leds_on; i > 1; i--) {
 248:Core/Src/main.c ****                 uint8_t j = (uint8_t)(rand() % i);
 249:Core/Src/main.c ****                 uint8_t t = sparkle_leds_on[i - 1];
 250:Core/Src/main.c ****                 sparkle_leds_on[i - 1] = sparkle_leds_on[j];
 251:Core/Src/main.c ****                 sparkle_leds_on[j] = t;
 252:Core/Src/main.c ****             }
 253:Core/Src/main.c **** 
 254:Core/Src/main.c ****             sparkle_off_index     = 0;
 255:Core/Src/main.c ****             sparkle_display_until = now + rand_range(SPARKLE_HOLD_MIN_MS, SPARKLE_HOLD_MAX_MS);
 256:Core/Src/main.c ****             sparkle_state         = SPARKLE_DISPLAY;
 257:Core/Src/main.c ****             break;
 258:Core/Src/main.c **** 
 259:Core/Src/main.c ****         case SPARKLE_DISPLAY:
 260:Core/Src/main.c ****             if ((int32_t)(now - sparkle_display_until) >= 0) {
 261:Core/Src/main.c ****                 sparkle_next_off_time = now;    // first LED goes off straight away
 262:Core/Src/main.c ****                 sparkle_state         = SPARKLE_TURN_OFF;
 263:Core/Src/main.c ****             }
 264:Core/Src/main.c ****             break;
 265:Core/Src/main.c **** 
 266:Core/Src/main.c ****         case SPARKLE_TURN_OFF:
 267:Core/Src/main.c ****             if (sparkle_off_index >= sparkle_num_leds_on) {
 268:Core/Src/main.c ****                 sparkle_state = SPARKLE_IDLE;   // all off, start a new pattern
 269:Core/Src/main.c ****                 break;
 270:Core/Src/main.c ****             }
 271:Core/Src/main.c ****             if ((int32_t)(now - sparkle_next_off_time) >= 0) {
 272:Core/Src/main.c ****                 turn_off_led(sparkle_leds_on[sparkle_off_index]);
 273:Core/Src/main.c ****                 sparkle_off_index++;
 274:Core/Src/main.c ****                 sparkle_next_off_time = now + rand_range(SPARKLE_OFF_MIN_MS, SPARKLE_OFF_MAX_MS);
 275:Core/Src/main.c ****             }
ARM GAS  C:\Users\Tebogo\AppData\Local\Temp\ccXvoXA9.s 			page 7


 276:Core/Src/main.c ****             break;
 277:Core/Src/main.c **** 
 278:Core/Src/main.c ****         default:
 279:Core/Src/main.c ****             sparkle_state = SPARKLE_IDLE;
 280:Core/Src/main.c ****             break;
 281:Core/Src/main.c ****     }
 282:Core/Src/main.c **** }
