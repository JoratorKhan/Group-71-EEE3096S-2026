 289:Core/Src/main.c **** int main(void)
 290:Core/Src/main.c **** {
 291:Core/Src/main.c ****     HAL_Init();
 292:Core/Src/main.c ****     SystemClock_Config();
 293:Core/Src/main.c ****     MX_GPIO_Init();
 294:Core/Src/main.c ****     MX_TIM16_Init();
 295:Core/Src/main.c **** 
 296:Core/Src/main.c ****     /* USER CODE BEGIN 2 */
 297:Core/Src/main.c ****     srand(HAL_GetTick());
 298:Core/Src/main.c **** 
 299:Core/Src/main.c ****     clear_all_leds();
 300:Core/Src/main.c **** 
 301:Core/Src/main.c ****     // Sample the resting level of each button so polarity is detected
 302:Core/Src/main.c ****     // automatically. Do not hold a button while the board powers up.
 303:Core/Src/main.c ****     for (uint8_t i = 0; i < NUM_BUTTONS; i++) {
 304:Core/Src/main.c ****         button_idle_state[i] = HAL_GPIO_ReadPin(GPIOA, button_pins[i]);
 305:Core/Src/main.c ****         button_stable[i]     = button_idle_state[i];
 306:Core/Src/main.c ****         button_last_raw[i]   = button_idle_state[i];
 307:Core/Src/main.c ****         last_button_time[i]  = HAL_GetTick();
 308:Core/Src/main.c ****     }
 309:Core/Src/main.c **** 
 310:Core/Src/main.c ****     change_timer_period(1000);
 311:Core/Src/main.c ****     HAL_TIM_Base_Start_IT(&htim16);
 312:Core/Src/main.c ****     /* USER CODE END 2 */
 313:Core/Src/main.c **** 
 314:Core/Src/main.c ****     while (1)
 315:Core/Src/main.c ****     {
 316:Core/Src/main.c ****         /* USER CODE BEGIN WHILE */
 317:Core/Src/main.c ****         handle_buttons();
 318:Core/Src/main.c **** 
 319:Core/Src/main.c ****         // Timer-driven updates for Mode 1 and Mode 2
 320:Core/Src/main.c ****         if (timer_event) {
 321:Core/Src/main.c ****             timer_event = 0;
 322:Core/Src/main.c **** 
