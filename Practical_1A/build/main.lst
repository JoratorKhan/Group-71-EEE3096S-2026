   1:Core/Src/main.c **** /*
   2:Core/Src/main.c ****  * Task 7: Software PWM via Timer Interrupts
   3:Core/Src/main.c ****  * Target: STM32F051C8 (UCT Dev Board)
   4:Core/Src/main.c ****  * Output: PB5 (Byte of LEDs bit D5)
   5:Core/Src/main.c ****  * Signal: 100 Hz, 30% duty cycle, generated entirely in software
   6:Core/Src/main.c ****  */
   7:Core/Src/main.c **** #include "stm32f0xx.h"
   8:Core/Src/main.c **** 
